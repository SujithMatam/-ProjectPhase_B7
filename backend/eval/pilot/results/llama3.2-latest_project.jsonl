{"id": "p06", "domain": "rehab", "procedure": "THA", "answerability": "full", "model": "llama3.2:latest", "model_digest": "a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72", "variant": "project", "project_layout": "system_user", "status": "ok", "error": null, "response": "You're doing great with your physical therapy! Based on your progress, your therapist will likely recommend that you start walking without the walker around Day 21, but this will depend on your individual healing and comfort level. For now, focus on gentle movements and exercises to help your hip feel more comfortable, and don't hesitate to reach out to your therapist if you experience any pain or discomfort.", "response_sha256": "4c969b7a9aba4ca0f384ef3d87157f29a497dd9eaf5eed5e65d499f7a5a11763", "empty_response": false, "thinking": null, "done_reason": "stop", "latency_s": {"first_chunk": 0.18401810000068508, "first_token": 0.18401810000068508, "first_thinking": null, "total": 1.2911672000191174}, "ollama_timings": {"total_duration_ns": 1289562100, "load_duration_ns": 6711400, "prompt_eval_count": 403, "prompt_eval_duration_ns": 128138000, "eval_count": 79, "eval_duration_ns": 1122504000, "eval_tokens_per_s": 70.38}, "memory": {"gpu_used_at_start_mib": 2533, "gpu_used_peak_mib": 2533, "ollama_process_peak_mib": 76.3, "ollama_process_method": "psutil_rss", "sample_interval_s": 0.25, "samples": 3, "loaded_model": {"size_bytes": 2554708622, "size_vram_bytes": 2554708622}}, "options": {"temperature": 0, "num_predict": 300, "seed": 0, "num_ctx": 4096}, "think": null, "prompt_sha256": "d60808e4cb28feb5dc181acd8c732765864de369b3fee66741a711c4a90526ec", "context_sha256": "5f2f17759ca43fbf8124ab37e890b71f2aeaa441537c0421a9b6dc2ebf7be531", "corpus": {"kind": "rag_store_copy", "path": "rag/data/seed_knowledge.json", "sha256": "35996f41a8bce0a2bd43920c44347b340481f0da120eebb855255c02c1af9e94"}, "query_sha256": "ad714446db12ef038a16d3217af9b59670c35d496848d99eb30e7a1d2c190024", "postop_day": 21, "n_context_chunks": 2, "prompt_chars": 1898, "context_may_be_truncated": false, "started_at": "2026-09-28T09:32:57+00:00", "finished_at": "2026-09-28T09:32:59+00:00", "harness_version": "1"}
{"id": "p07", "domain": "rehab", "procedure": "TKA", "answerability": "partial", "model": "llama3.2:latest", "model_digest": "a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72", "variant": "project", "project_layout": "system_user", "status": "ok", "error": null, "response": "At this stage, it's generally recommended to avoid high-impact activities like cycling on a stationary bike for a while after Total Knee Arthroplasty (TKA). Your goal for Day 42 is to continue progressing with gentle exercises to maintain range of motion and mobility in your knee. You can start with some gentle leg swings and straight leg raises, but it's best to check with your doctor or physiotherapist before starting any cycling or high-impact activities.", "response_sha256": "459a55c62c7d9d01577ff6f6c29aa077ff6b1ff48fee268d91e0dd30f7a92e75", "empty_response": false, "thinking": null, "done_reason": "stop", "latency_s": {"first_chunk": 0.11482869999599643, "first_token": 0.11482869999599643, "first_thinking": null, "total": 1.480183899984695}, "ollama_timings": {"total_duration_ns": 1458195100, "load_duration_ns": 7636500, "prompt_eval_count": 180, "prompt_eval_duration_ns": 64147000, "eval_count": 96, "eval_duration_ns": 1356484000, "eval_tokens_per_s": 70.77}, "memory": {"gpu_used_at_start_mib": 2533, "gpu_used_peak_mib": 2533, "ollama_process_peak_mib": 76.4, "ollama_process_method": "psutil_rss", "sample_interval_s": 0.25, "samples": 4, "loaded_model": {"size_bytes": 2554708622, "size_vram_bytes": 2554708622}}, "options": {"temperature": 0, "num_predict": 300, "seed": 0, "num_ctx": 4096}, "think": null, "prompt_sha256": "29e4c9d6226108955fbed3f881bde5d92a8733c2ce3156ce444c2ad8568c6030", "context_sha256": "f387ddd97cdf6c5beb78271e5e8331a83da4ab5e0d3583ecfa7617b2963998ad", "corpus": {"kind": "rag_store_copy", "path": "rag/data/seed_knowledge.json", "sha256": "35996f41a8bce0a2bd43920c44347b340481f0da120eebb855255c02c1af9e94"}, "query_sha256": "688bfbeaf0478e3dbe87eaa1334613e5